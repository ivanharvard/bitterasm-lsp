{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "BitterASM",
  "scopeName": "source.basm",
  "fileTypes": ["basm"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#chars" },
    { "include": "#numbers" },
    { "include": "#metaprogramming" },
    { "include": "#dotted" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#captures" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.basm",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.basm",
          "begin": "\"",
          "end": "\"",
          "patterns": [{ "name": "constant.character.escape.basm", "match": "\\\\." }]
        }
      ]
    },
    "chars": {
      "comment": "A char literal is sugar for its codepoint as a plain integer (see lexer.rs's lex_char), so it's scoped as a numeric constant rather than a string.",
      "patterns": [
        {
          "name": "constant.numeric.basm",
          "match": "'([^'\\\\]|\\\\.)'"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.basm",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "metaprogramming": {
      "patterns": [
        {
          "name": "keyword.control.directive.basm",
          "match": "@\\s*[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "dotted": {
      "comment": "Names with a leading `.`, matched before #keywords so a keyword after the dot (`.skip`, `.type`) isn't colored as one. A section name (`section .text`) and a relative import path (`from .foo import`) aren't labels, so they're claimed first; a dotted label (`.loop:`, `jmp .loop`) is a `.` not glued to a value before it (that would be member access, `str.len`).",
      "patterns": [
        {
          "match": "\\b(section)\\s+\\.?[A-Za-z_][A-Za-z0-9_.]*",
          "captures": { "1": { "name": "keyword.control.section.basm" } }
        },
        {
          "match": "\\b(from)\\s+\\.+[A-Za-z_][A-Za-z0-9_.]*",
          "captures": { "1": { "name": "keyword.control.import.basm" } }
        },
        {
          "name": "entity.name.label.basm",
          "match": "(?<![A-Za-z0-9_)\\]}.])\\.[A-Za-z_][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.import.basm",
          "match": "\\b(from|import|as)\\b"
        },
        {
          "name": "storage.modifier.basm",
          "match": "\\b(pub|skip)\\b"
        },
        {
          "name": "storage.type.basm",
          "match": "\\b(macro|type|struct|enum|const)\\b"
        },
        {
          "name": "keyword.control.section.basm",
          "match": "\\bsection\\b"
        },
        {
          "name": "keyword.other.lint.basm",
          "match": "\\b(allow|expect|warn|deny|forbid|syntax|before|after|invariant|from|to|emits|leaks_section)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.primitive.basm",
          "match": "\\bint\\b"
        },
        {
          "comment": "`Fn(...)` / `Fn(...) -> ...` — the one generic-parameter bound the language understands (`F: Fn(T) -> S`), recognized by name rather than a real keyword.",
          "name": "support.type.fn-bound.basm",
          "match": "\\bFn\\b(?=\\s*\\()"
        },
        {
          "comment": "A bare identifier shaped like a generic type parameter (T, U, K, N, T1, ...): a single uppercase letter followed only by digits.",
          "name": "entity.name.type.parameter.basm",
          "match": "\\b[A-Z][0-9]*\\b"
        }
      ]
    },
    "captures": {
      "patterns": [
        {
          "name": "variable.parameter.capture.basm",
          "match": "\\$[A-Za-z_][A-Za-z0-9_]*\\$"
        },
        {
          "name": "keyword.operator.backtick.basm",
          "match": "`[^`]*`"
        }
      ]
    }
  }
}
