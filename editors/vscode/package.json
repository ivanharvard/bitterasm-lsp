{
  "name": "bitterasm-vscode",
  "displayName": "BitterASM",
  "description": "Syntax highlighting, go-to-definition, and diagnostics for BitterASM (.basm) via bitterasm-lsp.",
  "version": "0.1.0",
  "publisher": "ivanharvard",
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#452b17",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ivanharvard/bitterasm-lsp"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Programming Languages"],
  "activationEvents": ["onLanguage:basm"],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "basm",
        "aliases": ["BitterASM", "basm"],
        "extensions": [".basm"],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/basm-file-icon.png",
          "dark": "./icons/basm-file-icon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "basm",
        "scopeName": "source.basm",
        "path": "./syntaxes/basm.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "BitterASM",
      "properties": {
        "bitterasm-lsp.serverPath": {
          "type": "string",
          "default": "bitterasm-lsp",
          "description": "Path to the bitterasm-lsp executable. Defaults to looking it up on PATH."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package -o bitterasm-vscode.vsix"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.24.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
